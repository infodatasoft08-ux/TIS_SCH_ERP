<div class="mt-4 pt-3 border-t border-border-color flex justify-between items-center footer-text">
  <div class="flex gap-3 items-center">
    {{#if qr_code}}
      <img src="{{qr_code}}" alt="QR Code" class="qr-code">
    {{/if}}
    <div class="flex-col">
      <span class="font-semibold text-dark">Scan QR to Verify</span>
      <span>Report Card No: {{meta.report_id}}</span>
      <span>Generated On: {{meta.generated_on}}</span>
    </div>
  </div>
  
  <div class="text-right">
    <div>Generated By: {{meta.generated_by}}</div>
    <div>Software powered by {{meta.erp_name}} v{{meta.erp_version}}</div>
    <div>&copy; {{meta.year}} All Rights Reserved</div>
  </div>
</div>
