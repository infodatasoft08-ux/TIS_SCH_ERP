<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Card - {{student.name}}</title>

  <!-- Embedding CSS exactly where it belongs for Handlebars Puppeteer, avoiding external file loading issues -->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Montserrat:wght@400;600;700;800;900&family=Poppins:wght@400;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap');

    @font-face {
      font-family: 'Luckiest Guy';
      src: url('data:font/truetype;charset=utf-8;base64,{{luckiestFontBase64}}') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    :root {
      --primary-blue: #1565C0;
      --dark-blue: #0D47A1;
      --gold: #FFC107;
      --border-color: #DADADA;
      --bg-color: #FFFFFF;
      --section-bg: #F8FAFC;
      --success: #16A34A;
      --danger: #DC2626;
      --text-dark: #1e293b;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg-color);
      color: var(--text-dark);
      font-family: 'Poppins', sans-serif;
      font-size: 11px;
      /* Base size for A4 printing */
      line-height: 1.3;
      /* A4 Dimensions */
      width: 210mm;
      height: 297mm;
      margin: 0 auto;
      position: relative;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /* Page Margins */
    .page-container {
      padding: 2mm 8mm;
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
    }

    /* Watermark */
    .watermark-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.16;
      z-index: 1;
      pointer-events: none;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .watermark-container img {
      width: 140mm;
      height: 140mm;
      object-fit: contain;
    }

    /* Typography */
    .school-name {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 24px;
      color: var(--dark-blue);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .school-details {
      font-size: 12.5px;
      color: var(--text-muted);
    }

    .section-heading {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 11px;
      color: #0e4ea6;
      background: linear-gradient(90deg, #dbeafe 0%, #eff6ff 100%);
      padding: 2px 8px;
      border-radius: 4px;
      margin-bottom: 3.5px;
      border-left: 3.5px solid #0e4ea6;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .section-heading svg {
      width: 12px;
      height: 12px;
      flex-shrink: 0;
    }

    .table-marks {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
    }

    .table-marks tbody td {
      font-weight: 700;
    }

    /* Utilities */
    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }

    .text-left {
      text-align: left;
    }

    .text-primary {
      color: var(--primary-blue);
    }

    .text-dark {
      color: var(--dark-blue);
    }

    .text-gold {
      color: var(--gold);
    }

    .text-success {
      color: var(--success);
    }

    .text-danger {
      color: var(--danger);
    }

    .text-muted {
      color: var(--text-muted);
    }

    .font-semibold {
      font-weight: 700;
    }

    .font-bold {
      font-weight: 700;
    }

    .mt-1 {
      margin-top: 4px;
    }

    .mt-2 {
      margin-top: 8px;
    }

    .mt-3 {
      margin-top: 12px;
    }

    .mt-4 {
      margin-top: 16px;
    }

    .mb-1 {
      margin-bottom: 4px;
    }

    .mb-2 {
      margin-bottom: 8px;
    }

    .mb-3 {
      margin-bottom: 12px;
    }

    .mb-4 {
      margin-bottom: 16px;
    }

    .flex {
      display: flex;
    }

    .flex-col {
      display: flex;
      flex-direction: column;
    }

    .items-center {
      align-items: center;
    }

    .items-end {
      align-items: flex-end;
    }

    .justify-between {
      justify-content: space-between;
    }

    .justify-center {
      justify-content: center;
    }

    .gap-2 {
      gap: 8px;
    }

    .gap-3 {
      gap: 12px;
    }

    .gap-4 {
      gap: 16px;
    }

    .grid {
      display: grid;
    }

    .grid-cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .grid-cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }

    .gap-x-4 {
      column-gap: 16px;
    }

    .gap-y-2 {
      row-gap: 8px;
    }

    .w-full {
      width: 100%;
    }

    .h-full {
      height: 100%;
    }

    .flex-1 {
      flex: 1;
    }

    /* Cards & Sections */
    .card {
      background: rgba(240, 246, 255, 0.45);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 6px;
    }

    .card-highlight {
      background: linear-gradient(135deg, var(--dark-blue), var(--primary-blue));
      color: white;
      border: none;
    }

    .card-highlight .section-heading {
      color: white;
      background: rgba(255, 255, 255, 0.1);
      border-left-color: var(--gold);
    }

    .card-highlight .text-muted {
      color: rgba(255, 255, 255, 0.8);
    }

    .card-highlight .text-dark {
      color: white;
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;

      border: 1px solid var(--border-color);
      border-radius: 6px;
      overflow: hidden;
    }

    th,
    td {
      padding: 2.2px 3.5px;
      border: 1px solid var(--border-color);
      font-size: 13.5px;
      text-align: center;
    }

    th {
      background: #0e4da6be;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      color: #ffffff;
      text-align: center;
      vertical-align: middle;
      border: 1px solid #1d4fd8ba;
    }

    th small {
      font-size: 9.5px;
      font-weight: 500;
      opacity: 0.95;
      display: block;
      text-align: center;
    }

    .table-marks thead tr:first-child th:first-child,
    .table-marks tbody td:first-child,
    .table-marks .row-total td:first-child {
      text-align: left;
      white-space: nowrap;
      padding-left: 8px;
      padding-right: 8px;
    }

    .table-marks thead tr:not(:first-child) th {
      text-align: center !important;
      padding-left: 4px;
      padding-right: 4px;
    }

    .table-marks th:not(:first-child),
    .table-marks td:not(:first-child) {
      white-space: nowrap;
    }


    thead tr:nth-child(2) th:last-child {
      border-right: 1px solid var(--border-color);
    }


    tbody tr:nth-child(even) {
      background-color: rgba(248, 250, 252, 0.4);
    }

    .table-header-group {
      background: transparent;
      border-bottom: 2px solid #0a397cc3;
    }

    .table-header-group th {
      border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    }

    .row-total td {
      background-color: rgba(241, 245, 249, 0.6);
      font-weight: 700;
      color: var(--dark-blue);
    }

    /* Specific elements */
    .student-photo {
      width: 22mm;
      height: 28mm;
      object-fit: cover;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 2px;
      background: white;
    }

    .info-label {
      font-size: 10px;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 1.5px;
    }

    .info-value {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .progress-bar-bg {
      background: var(--border-color);
      border-radius: 10px;
      height: 6px;
      width: 100%;
      overflow: hidden;
      margin-top: 4px;
    }

    .progress-bar-fill {
      background: var(--success);
      height: 100%;
      border-radius: 10px;
    }

    .badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 10px;
      font-size: 8px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .badge-success {
      background: #dcfce7;
      color: var(--success);
    }

    .badge-danger {
      background: #fee2e2;
      color: var(--danger);
    }

    .badge-primary {
      background: #e0f2fe;
      color: var(--primary-blue);
    }

    .remarks-box {
      min-height: 40px;
      font-style: italic;
      font-size: 11.5px;
      color: var(--text-dark);
      border: 1px dashed var(--border-color);
      padding: 6px 8px;
      border-radius: 4px;
      background: rgba(240, 246, 255, 0.45);
      line-height: 1.35;
    }

    /* Signatures */
    .signature-box {
      border-top: 1px solid var(--border-color);
      width: 35mm;
      text-align: center;
      padding-top: 2px;
      margin-top: 5px;
      /* space for signature */
      font-size: 8.5px;
      font-weight: 600;
      color: var(--text-dark);
    }

    .signature-img {
      height: 25px;
      margin-bottom: 5px;
      object-fit: contain;
    }

    .qr-code {
      width: 11mm;
      height: 11mm;
      object-fit: contain;
      border: 1px solid var(--border-color);
      border-radius: 3px;
      padding: 1px;
      background: white;
    }

    .footer-text {
      font-size: 7.5px;
      color: var(--text-muted);
    }

    .tagline-banner {
      margin: 6px auto 7px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      max-width: 460px;
    }

    .tagline-text {
      /*background: linear-gradient(180deg, #0d2873 0%, #061543 100%);*/
      background: #0a397cda;
      color: #ffffff;
      font-weight: 700;
      font-size: 10px;
      padding: 3px 20px;
      clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 100%, 0 100%);
      letter-spacing: 0.4px;
    }

    .tagline-diamond {
      width: 6px;
      height: 6px;
      background: #eab308;
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    .tagline-line {
      flex: 1;
      height: 1.5px;
    }

    .progress-report-text {
      font-family: 'Luckiest Guy', 'Montserrat', cursive, sans-serif;
      font-size: 16px;
      font-weight: 900;
      font-style: italic;
      letter-spacing: 1.5px;
      color: #103b9b;
      -webkit-text-stroke: 0.5px #103b9b;
      text-transform: uppercase;
      display: inline-block;
      line-height: 1;
      text-shadow: 0.5px 0.5px 0px rgba(16, 59, 155, 0.25);
    }

    /* Printing logic */
    @media print {
      @page {
        size: A4 portrait;
        margin: 0;
      }

      body {
        width: 210mm;
        height: 297mm;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        margin: 0;
      }

      .page-container {
        page-break-after: avoid;
        page-break-inside: avoid;
      }

      table,
      tr,
      td,
      th {
        page-break-inside: avoid;
      }
    }
  </style>
</head>

<body>

  {{#if logoData}}
  <div class="watermark-container">
    <img src="{{logoData}}" alt="Watermark">
  </div>
  {{else if school.logo}}
  <div class="watermark-container">
    <img src="{{school.logo}}" alt="Watermark">
  </div>
  {{/if}}

  <div class="page-container">

    <!-- 1. HEADER (Structured HTML/CSS Layout based on Official Branding) -->
    <div class="mb-1" style="width: 100%; overflow: hidden; background: #fff; text-align: center;">
      <!-- Logo + Divider + School Name Block centered horizontally -->
      <div
        style="display: flex; align-items: center; justify-content: center; width: 100%; margin: 0 auto 1px auto; padding: 0;">
        <!-- Left Logo -->
        <div style="display: flex; align-items: center; justify-content: center; padding-right: 14px; flex-shrink: 0;">
          {{#if logoData}}
          <img src="{{logoData}}" alt="School Logo" style="width: 25mm; height: 25mm; object-fit: contain;">
          {{else if school.logo}}
          <img src="{{school.logo}}" alt="School Logo" style="width: 25mm; height: 25mm; object-fit: contain;">
          {{/if}}
        </div>

        <!-- Vertical Maroon Divider Line -->
        <div style="width: 2.5px; height: 18mm; background-color: #8B1E1E; margin-right: 16px; flex-shrink: 0;"></div>

        <!-- School Name in 2 Stacked Lines -->
        <div style="text-align: left; display: flex; flex-direction: column; justify-content: center;">
          <div
            style="font-family: 'Times New Roman', 'Playfair Display', Georgia, serif; font-weight: 1000; font-size: 39px; color: #8B1E1E; line-height: 0.92; letter-spacing: 2px;">
            TIMES
          </div>
          <div
            style="font-family: 'Times New Roman', 'Playfair Display', Georgia, serif; font-weight: 1000; font-size: 31px; color: #8B1E1E; line-height: 1.0; letter-spacing: 1px; margin-top: 2px;">
            INTERNATIONAL SCHOOL
          </div>
        </div>
      </div>

      <!-- Address, Contact, and Web details -->
      <div
        style="text-align: center; color: #1e293b; font-size: 11px; line-height: 1.25; margin-top: 1px; padding: 0 4px;">
        <p style="margin-bottom: 1px; font-weight: 700;">
          <span>Address : {{#if school.address}}{{school.address}}{{else}}Times School Road, Muhammadpur, Shahganj,
            Mahendru, Patna - 800006{{/if}}</span>
        </p>
        <p style="margin-bottom: 1px; font-weight: 700;">
          <span>Cont.: {{#if school.phone}}{{school.phone}}{{else}}0612-4089151 | 8700186374 | 8102657225{{/if}}</span>
        </p>
        <p style="font-weight: 600;">
          <span>Email: {{#if school.email}}{{school.email}}{{else}}timesschoolpatna@gmail.com{{/if}}</span>
          <span style="margin: 0 6px; color: #94a3b8;">|</span>
          <span>Website: <span style="font-weight: 700; color: #0f4c92;">{{#if
              school.website}}{{school.website}}{{else}}www.timesinternationalschool.com{{/if}}</span></span>
        </p>
      </div>

      {{#if school.tagline}}
      <div class="tagline-banner">
        <div class="tagline-line" style="background: linear-gradient(to right, transparent, #eab308);">
        </div>
        <div class="tagline-diamond"></div>
        <div class="tagline-text">{{school.tagline}}</div>
        <div class="tagline-diamond"></div>
        <div class="tagline-line" style="background: linear-gradient(to left, transparent, #eab308);">
        </div>
      </div>
      {{/if}}

      <!-- Header Sub-Bar: Progress Report & Session -->
      <div class="flex items-center justify-center px-3 py-1 gap-2" style="text-align: center; margin-top: 3px;">
        <span class="progress-report-text">
          PROGRESS REPORT
        </span>
        {{#if reportTitle}}
        <span class="font-bold uppercase"
          style="color: #0f4c92; font-size: 16px; letter-spacing: 0.5px; font-family: 'Montserrat', sans-serif; line-height: 1; margin-top: 2px;">
          {{reportTitle}}
        </span>
        {{/if}}
        <span
          style="background-color: #e0f2fe; color: #0284c7; font-weight: 700; font-size: 14px; padding: 2px 10px; border-radius: 12px; white-space: nowrap; letter-spacing: 0.3px; line-height: 1; display: inline-flex; align-items: center;">
          (Session : {{#if student.academic_year_name}}{{student.academic_year_name}}{{else if
          school.session}}{{school.session}}{{else}}2026-2027{{/if}})
        </span>
      </div>
    </div>


    <!-- 2. STUDENT PROFILE -->
    <div class="card mb-1" style="padding: 4px 8px;">
      <div class="flex justify-between gap-3">
        <!-- Left Side: Student Info Grid -->
        <div class="flex-1 grid grid-cols-3 gap-x-3 gap-y-1">
          <div>
            <div class="info-label">Admission No</div>
            <div class="info-value">{{student.admission_no}}</div>
          </div>
          <div>
            <div class="info-label">Roll No</div>
            <div class="info-value">{{student.roll_no}}</div>
          </div>
          <div>
            <div class="info-label">Class</div>
            <div class="info-value">{{student.class_name}}</div>
          </div>

          <div>
            <div class="info-label">Student Name</div>
            <div class="info-value">{{student.name}}</div>
          </div>
          <div>
            <div class="info-label">Date of Birth</div>
            <div class="info-value">{{student.dob}}</div>
          </div>
          <div>
            <div class="info-label">Gender / Blood Group</div>
            <div class="info-value">{{student.gender}} / {{student.blood_group}}</div>
          </div>

          <div>
            <div class="info-label">Father's Name</div>
            <div class="info-value">{{#if
              student.father_name}}{{student.father_name}}{{else}}{{student.fathers_name}}{{/if}}</div>
          </div>
          <div>
            <div class="info-label">Mother's Name</div>
            <div class="info-value">{{#if
              student.mother_name}}{{student.mother_name}}{{else}}{{student.mothers_name}}{{/if}}</div>
          </div>
          <div class="grid-col-span-2" style="grid-column: span 3;">
            <div class="info-label">Address</div>
            <div class="info-value">{{student.address}}</div>
          </div>
        </div>

        <!-- Right Side: Photo and Status -->
        <div class="flex-col items-center justify-center border-l"
          style="padding-left: 16px; border-left: 1px solid var(--border-color);">
          {{#if (or student.photo student.avatar_url)}}
          <img src="{{#if student.photo}}{{student.photo}}{{else}}{{student.avatar_url}}{{/if}}" alt="Student Photo"
            class="student-photo mb-2">
          {{else}}
          <div class="student-photo mb-2 bg-gray-100 flex items-center justify-center text-muted">No Photo</div>
          {{/if}}
          <div class="badge {{#if (eq student.status 'Active')}}badge-success{{else}}badge-danger{{/if}}">
            {{#if student.status}}{{student.status}}{{else}}Active{{/if}}
          </div>
        </div>
      </div>
    </div>


    <!-- 3. MARKS TABLE -->
    <div class="mb-2">
      {{!-- <div class="section-heading">Part 1: Scholastic Areas</div> --}}
      <table class="table-marks data-table" style="margin-bottom: 0;">
        <thead>
          {{#if showFinalResult}}
          {{#if hasIaSubSubjects}}
          <tr class="table-header-group">
            <th rowspan="3" style="text-align: left;">Subjects</th>
            <th rowspan="3">Max Marks</th>
            <th colspan="{{exam1ColSpan}}">{{exam1Name}}</th>
            <th colspan="{{exam2ColSpan}}">{{exam2Name}}</th>
            <th rowspan="3">Final Total</th>
            <th rowspan="3">Grade</th>
          </tr>
          <tr>
            <!-- Term 1 columns -->
            {{#if showTheory}}<th rowspan="2">Theory <br><small>({{maxTheory}})</small></th>{{/if}}
            {{#if showLab}}<th rowspan="2">Lab <br><small>({{maxLab}})</small></th>{{/if}}
            <th colspan="{{iaColSpan}}">I.A({{iaTotalMax}})</th>
            {{#if showIaPr}}<th rowspan="2">Practical <br><small>({{maxIaPr}})</small></th>{{/if}}
            {{#if showOral}}<th rowspan="2">Oral <br><small>({{maxOral}})</small></th>{{/if}}
            {{#if showWritten}}<th rowspan="2">Written <br><small>({{maxWritten}})</small></th>{{/if}}
            <th rowspan="2">Total</th>

            <!-- Term 2 columns -->
            {{#if showTheory}}<th rowspan="2">Theory <br><small>({{maxTheory}})</small></th>{{/if}}
            {{#if showLab}}<th rowspan="2">Lab <br><small>({{maxLab}})</small></th>{{/if}}
            <th colspan="{{iaColSpan}}">I.A({{iaTotalMax}})</th>
            {{#if showIaPr}}<th rowspan="2">Practical <br><small>({{maxIaPr}})</small></th>{{/if}}
            {{#if showOral}}<th rowspan="2">Oral <br><small>({{maxOral}})</small></th>{{/if}}
            {{#if showWritten}}<th rowspan="2">Written <br><small>({{maxWritten}})</small></th>{{/if}}
            <th rowspan="2">Total</th>
          </tr>
          <tr>
            <!-- Term 1 IA columns -->
            {{#if showReading}}<th style="text-align: center;">Reading <br><small>({{maxReading}})</small></th>{{/if}}
            {{#if showWritingComp}}<th style="text-align: center;">Writing <br><small>({{maxWritingComp}})</small></th>
            {{/if}}
            {{#if showDictation}}<th style="text-align: center;">Dictation <br><small>({{maxDictation}})</small></th>
            {{/if}}
            {{#if showRecitation}}<th style="text-align: center;">Recitation <br><small>({{maxRecitation}})</small></th>
            {{/if}}

            <!-- Term 2 IA columns -->
            {{#if showReading}}<th style="text-align: center;">Reading <br><small>({{maxReading}})</small></th>{{/if}}
            {{#if showWritingComp}}<th style="text-align: center;">Writing <br><small>({{maxWritingComp}})</small></th>
            {{/if}}
            {{#if showDictation}}<th style="text-align: center;">Dictation <br><small>({{maxDictation}})</small></th>
            {{/if}}
            {{#if showRecitation}}<th style="text-align: center;">Recitation <br><small>({{maxRecitation}})</small></th>
            {{/if}}
          </tr>
          {{else}}
          <tr class="table-header-group">
            <th rowspan="2" style="text-align: left;">Subjects</th>
            <th rowspan="2">Max Marks</th>
            <th colspan="{{exam1ColSpan}}">{{exam1Name}}</th>
            <th colspan="{{exam2ColSpan}}">{{exam2Name}}</th>
            <th rowspan="2">Final Total</th>
            <th rowspan="2">Grade</th>
          </tr>
          <tr>
            <!-- Term 1 columns -->
            {{#each dynamicColumns}}<th>{{this.name}} <br><small>({{this.max}})</small></th>{{/each}}
            <th>Total</th>

            <!-- Term 2 columns -->
            {{#each dynamicColumns}}<th>{{this.name}} <br><small>({{this.max}})</small></th>{{/each}}
            <th>Total</th>
          </tr>
          {{/if}}
          {{else}}
          {{#if hasIaSubSubjects}}
          <tr class="table-header-group">
            <th rowspan="2" style="text-align: left;">Subjects</th>
            <th rowspan="2">Max Marks</th>
            {{#if showTheory}}
            <th rowspan="2">Theory <br><small>({{maxTheory}})</small></th>
            {{/if}}
            {{#if showLab}}
            <th rowspan="2">Lab <br><small>({{maxLab}})</small></th>
            {{/if}}
            <th colspan="{{iaColSpan}}">I.A({{iaTotalMax}})</th>
            {{#if showIaPr}}
            <th rowspan="2">Practical <br><small>({{maxIaPr}})</small></th>
            {{/if}}
            {{#if showOral}}<th rowspan="2">Oral <br><small>({{maxOral}})</small></th>{{/if}}
            {{#if showWritten}}
            <th rowspan="2">Written <br><small>({{maxWritten}})</small></th>
            {{/if}}
            <th rowspan="2">Total</th>
            <th rowspan="2">Grade</th>
          </tr>
          <tr>
            <!-- Term 1 sub-subject columns under I.A({{iaTotalMax}}) -->
            {{#if showReading}}<th style="text-align: center; font-size: 10.5px;">Reading
              <br><small>({{maxReading}})</small>
            </th>{{/if}}
            {{#if showWritingComp}}<th style="text-align: center; font-size: 10.5px;">Writing
              <br><small>({{maxWritingComp}})</small>
            </th>
            {{/if}}
            {{#if showDictation}}<th style="text-align: center; font-size: 10.5px;">Dictation
              <br><small>({{maxDictation}})</small>
            </th>
            {{/if}}
            {{#if showRecitation}}<th style="text-align: center; font-size: 10.5px;">Recitation
              <br><small>({{maxRecitation}})</small>
            </th>
            {{/if}}
          </tr>
          {{else}}
          <tr class="table-header-group">
            <th style="text-align: left;">Subjects</th>
            <th>Max Marks</th>
            {{#each dynamicColumns}}<th>{{this.name}} <br><small>({{this.max}})</small></th>{{/each}}
            <th>Total</th>
            <th>Grade</th>
          </tr>
          {{/if}}
          {{/if}}
        </thead>
        <tbody>
          {{#each subjects}}
          <tr>
            <td style="text-align: left; font-weight: 700; color: var(--dark-blue);">{{this.subject_name}}</td>
            <td>{{this.max}}</td>
            <!-- Term 1 marks -->
            {{#each this.exam1_dynamicMarks}}<td>{{this.value}}</td>{{/each}}
            <td class="font-semibold">{{this.exam1_marks}}</td>

            <!-- Term 2 marks -->
            {{#if ../showFinalResult}}
            {{#each this.exam2_dynamicMarks}}<td>{{this.value}}</td>{{/each}}
            <td class="font-semibold">{{this.exam2_marks}}</td>

            <!-- Final Total -->
            <td class="font-bold text-primary">{{this.total}}</td>
            {{/if}}
            <td class="font-bold" style="color: {{gradeColor this.grade}};">{{this.grade}}</td>
          </tr>
          {{/each}}

          <!-- Totals Row -->
          <tr class="row-total">
            <td style="text-align: left;">Grand Total</td>
            <td>{{totalMax}}</td>
            {{#if showFinalResult}}
            <td colspan="{{exam1ColSpan}}" class="text-right" style="padding-right: 15px;">-</td>
            <td colspan="{{exam2ColSpan}}" class="text-right" style="padding-right: 15px;">-</td>
            <td class="text-primary font-bold">{{totalObtained}} / {{totalMax}}</td>
            {{else}}
            {{#if baseNewFields}}
            <td colspan="{{baseNewFields}}"></td>
            {{/if}}
            <td class="text-primary font-bold">{{totalObtained}}</td>
            <td class="font-bold" style="color: {{gradeColor grandGrade}};">{{#if
              grandGrade}}{{grandGrade}}{{else}}-{{/if}}</td>
            {{/if}}
          </tr>
        </tbody>
      </table>
    </div>


    <!-- 4. CO-SCHOLASTIC GRADING & ATTENDANCE / RESULT SUMMARY / GRAPH -->
    <style>
      .perf-chart-card {
        border: 1.5px solid #0e4ea6;
        border-left: 4px solid #0e4ea6;
        border-radius: 6px;
        padding: 4px 6px 3px 4px;
        background: linear-gradient(135deg, rgba(240, 247, 255, 0.6) 0%, rgba(224, 239, 254, 0.6) 100%);
        margin-bottom: 5px;
        box-shadow: 0 1px 3px rgba(14, 78, 166, 0.08);
      }

      .co-scholastic-table {
        margin-bottom: 0;
        border: 1px solid #0e4ea6;
        border-collapse: collapse;
        width: 100%;
      }

      .co-scholastic-table th,
      .co-scholastic-table td {
        padding: 3px 6px !important;
        font-size: 11.5px !important;
        line-height: 1.3 !important;
        border: 1px solid #cbd5e1 !important;
      }

      .co-scholastic-table th {
        background: #0e4da6c1 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        text-align: center;
        border-bottom: 2px solid #0a3a7c !important;
      }

      .co-scholastic-table td:first-child {
        text-align: left !important;
        font-weight: 600 !important;
        color: #334155 !important;
      }

      .att-card {
        border: 1.5px solid #0e4ea6;
        border-left: 4px solid #0e4ea6;
        border-radius: 6px;
        padding: 4px 6px;
        background: linear-gradient(135deg, rgba(240, 247, 255, 0.6) 0%, rgba(224, 239, 254, 0.6) 100%);
        margin-bottom: 5px;
        box-shadow: 0 1px 3px rgba(14, 78, 166, 0.08);
      }

      .att-title {
        color: #0e4ea6;
        font-weight: 700;
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 3px;
        letter-spacing: 0.4px;
        display: flex;
        align-items: center;
        gap: 4.5px;
      }

      .att-title svg {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
      }

      .att-grid {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        column-gap: 6px;
        align-items: center;
      }

      .att-pill {
        background: #ffffff;
        border: 1.5px solid #93c5fd;
        border-radius: 5px;
        padding: 3px 5px;
        text-align: center;
        min-height: 35px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .att-label {
        color: #475569;
        font-size: 9px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.25px;
        line-height: 1.1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
      }

      .att-label svg {
        width: 11px;
        height: 11px;
        flex-shrink: 0;
        color: #0e4ea6;
      }

      .att-val {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
        margin-top: 1px;
      }

      .result-summary-container {
        background: linear-gradient(135deg, rgba(240, 247, 255, 0.6) 0%, rgba(224, 239, 254, 0.6) 100%);
        border: 1.5px solid #0e4ea6;
        border-left: 4px solid #0e4ea6;
        border-radius: 6px;
        padding: 4px 6px;
        box-shadow: 0 1px 3px rgba(14, 78, 166, 0.08);
      }

      .result-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
      }

      .result-tile {
        border-radius: 6px;
        padding: 4px 6px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 40px;
      }

      .result-tile-percentage {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 1.5px solid #93c5fd;
        box-shadow: 0 1px 2px rgba(59, 130, 246, 0.08);
      }

      .result-tile-percentage .tile-label {
        color: #1e40af;
      }

      .result-tile-percentage .tile-val {
        color: #1d4ed8;
      }

      .result-tile-result-pass {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border: 1.5px solid #86efac;
        box-shadow: 0 1px 2px rgba(34, 197, 94, 0.08);
      }

      .result-tile-result-pass .tile-label {
        color: #15803d;
      }

      .result-tile-result-fail {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 1.5px solid #fca5a5;
        box-shadow: 0 1px 2px rgba(239, 68, 68, 0.08);
      }

      .result-tile-result-fail .tile-label {
        color: #b91c1c;
      }

      .result-tile-grade {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border: 1.5px solid #fde047;
        box-shadow: 0 1px 2px rgba(234, 179, 8, 0.08);
      }

      .result-tile-grade .tile-label {
        color: #854d0e;
      }

      .result-tile-grade .tile-val {
        color: #a16207;
      }

      .tile-label {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2.5px;
        line-height: 1.1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4.5px;
      }

      .tile-label svg {
        width: 13px;
        height: 13px;
        flex-shrink: 0;
      }

      .tile-val {
        font-size: 16px;
        font-weight: 700;
        line-height: 1.1;
      }

      .pill-badge-pass {
        background: #16a34a;
        color: #ffffff;
        padding: 2.5px 14px;
        border-radius: 9999px;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        box-shadow: 0 1px 3px rgba(22, 163, 74, 0.25);
        display: inline-block;
      }

      .pill-badge-fail {
        background: #dc2626;
        color: #ffffff;
        padding: 2.5px 14px;
        border-radius: 9999px;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        box-shadow: 0 1px 3px rgba(220, 38, 38, 0.25);
        display: inline-block;
      }

      .promotion-banner-strip {
        margin-top: 4px;
        padding-top: 3px;
        border-top: 1.5px dashed #bfdbfe;
        text-align: center;
        font-size: 10px;
        font-weight: 700;
        color: #1e3a8a;
      }

      .promotion-banner-strip span {
        color: #2563eb;
        font-weight: 800;
      }

      .remarks-box {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border: 1.5px solid #bfdbfe;
        border-left: 4px solid #2563eb;
        font-size: 9.5px;
        font-style: italic;
        color: #1e3a8a;
        font-weight: 600;
        padding: 5px 8px;
        min-height: 30px;
        display: flex;
        align-items: center;
        border-radius: 4px;
      }
    </style>

    <!-- 4. SUBJECT PERFORMANCE GRAPH (FULL WIDTH) -->
    {{#if (hasItems performanceChart)}}
    <div class="perf-chart-card" style="margin-top: 4px; margin-bottom: 6px;">
      <div class="section-heading" style="margin-bottom: 2px;">Subject Performance</div>
      <svg viewBox="0 0 680 102" style="width: 100%; height: 92px; display: block; overflow: visible;"
        xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid Lines -->
        <line x1="36" y1="12" x2="675" y2="12" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="2,2" />
        <line x1="36" y1="26" x2="675" y2="26" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="2,2" />
        <line x1="36" y1="40" x2="675" y2="40" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="2,2" />
        <line x1="36" y1="54" x2="675" y2="54" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="2,2" />
        <line x1="36" y1="68" x2="675" y2="68" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="2,2" />

        <!-- Y-Axis Labels -->
        <text x="30" y="16" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">100</text>
        <text x="30" y="30" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">80</text>
        <text x="30" y="44" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">60</text>
        <text x="30" y="58" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">40</text>
        <text x="30" y="72" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">20</text>
        <text x="30" y="85" font-size="10" font-weight="700" fill="#475569" text-anchor="end"
          font-family="'Poppins', sans-serif">0</text>

        <!-- Y-Axis & X-Axis Lines -->
        <line x1="35" y1="10" x2="35" y2="82" stroke="#64748b" stroke-width="1.2" />
        <line x1="35" y1="82" x2="675" y2="82" stroke="#64748b" stroke-width="1.2" />

        <!-- Bars & Labels -->
        {{#each performanceChart}}
        <text x="{{this.labelX}}" y="{{this.scoreY}}" font-size="11.5" font-weight="800" fill="#0f172a"
          text-anchor="middle" font-family="'Poppins', sans-serif">{{this.score}}</text>
        <rect x="{{this.barX}}" y="{{this.barY}}" width="{{this.barWidth}}" height="{{this.barHeight}}" rx="3" ry="3"
          fill="{{this.color}}" />
        <text x="{{this.labelX}}" y="97" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle"
          font-family="'Poppins', sans-serif">{{this.shortName}}</text>
        {{/each}}
      </svg>
    </div>
    {{/if}}

    <!-- 5. RESULT SUMMARY (Full Width) -->
    <div style="margin-bottom: 5px;">
      <div class="section-heading">Result Summary</div>
      <div class="result-summary-container">
        <div class="result-grid-3">
          <!-- Percentage Tile -->
          <div class="result-tile result-tile-percentage">
            <div class="tile-label">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="19" y1="5" x2="5" y2="19"></line>
                <circle cx="6.5" cy="6.5" r="2.5" fill="currentColor"></circle>
                <circle cx="17.5" cy="17.5" r="2.5" fill="currentColor"></circle>
              </svg>
              <span><b>Percentage</b></span>
            </div>
            <div class="tile-val"><b>{{percentage}}%</b></div>
          </div>

          <!-- Final Result Tile -->
          <div
            class="result-tile {{#if (eq finalResult 'Pass')}}result-tile-result-pass{{else}}result-tile-result-fail{{/if}}">
            <div class="tile-label">
              {{#if (eq finalResult 'Pass')}}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              {{else}}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              {{/if}}
              <span><b>Final Result</b></span>
            </div>
            <div class="tile-val">
              <span class="{{#if (eq finalResult 'Pass')}}pill-badge-pass{{else}}pill-badge-fail{{/if}}">
                <b>{{finalResult}}</b>
              </span>
            </div>
          </div>

          <!-- Grade or Promotion Status Tile -->
          <div class="result-tile result-tile-grade">
            <div class="tile-label">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <polygon
                  points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                </polygon>
              </svg>
              <span><b>{{#if showFinalResult}}Promotion Status{{else}}Overall Grade{{/if}}</b></span>
            </div>
            <div class="tile-val"
              style="color: {{#if showFinalResult}}#a16207{{else if grandGrade}}{{gradeColor grandGrade}}{{else}}#a16207{{/if}};">
              <b>
                {{#if showFinalResult}}
                {{#if promotionStatus}}{{promotionStatus}}{{else}}{{finalResult}}{{/if}}
                {{else if grandGrade}}
                {{grandGrade}}
                {{else}}
                {{finalResult}}
                {{/if}}
              </b>
            </div>
          </div>
        </div>

        {{#if showFinalResult}}
        {{#if nextGrade}}
        <div class="promotion-banner-strip">
          Promoted to Class: <span>{{nextGrade}}</span>
        </div>
        {{else if promotionStatus}}
        <div class="promotion-banner-strip">
          Promotion Status: <span>{{promotionStatus}}</span>
        </div>
        {{/if}}
        {{/if}}
      </div>
    </div>

    <!-- 6. LOWER SECTIONS (Co-Scholastic, Attendance & Teacher's Remarks) -->
    {{#if (or hasCoScholastic (hasItems coScholastic skillBased))}}
    <div class="grid grid-cols-2 gap-3" style="align-items: start;">
      <!-- Left Column: Co-Scholastic & Skill-Based Areas -->
      <div style="grid-column: span 1; display: flex; flex-direction: column;">
        <div class="section-heading">Part 2: Co-Scholastic & Skill-Based Areas</div>
        <table class="co-scholastic-table">
          <thead>
            <tr>
              <th style="text-align: left;">Activity / Area</th>
              {{#if attendanceStats.hasTerm2}}
              <th style="width: 55px;">Term I</th>
              <th style="width: 55px;">Term II</th>
              {{else}}
              <th style="width: 65px;">{{#if attendanceStats.hasTerm1}}Term I{{else}}Grade{{/if}}</th>
              {{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each coScholastic}}
            <tr>
              <td>{{this.name}}</td>
              {{#if ../attendanceStats.hasTerm2}}
              <td class="font-bold text-center" style="color: {{gradeColor this.term1}};">{{this.term1}}</td>
              <td class="font-bold text-center" style="color: {{gradeColor this.term2}};">{{this.term2}}</td>
              {{else}}
              <td class="font-bold text-center"
                style="color: {{#if this.term1}}{{gradeColor this.term1}}{{else}}{{gradeColor this.grade}}{{/if}};">
                {{#if this.term1}}{{this.term1}}{{else}}{{this.grade}}{{/if}}</td>
              {{/if}}
            </tr>
            {{/each}}
            {{#each skillBased}}
            <tr>
              <td>{{this.name}}</td>
              {{#if ../attendanceStats.hasTerm2}}
              <td class="font-bold text-center" style="color: {{gradeColor this.term1}};">{{this.term1}}</td>
              <td class="font-bold text-center" style="color: {{gradeColor this.term2}};">{{this.term2}}</td>
              {{else}}
              <td class="font-bold text-center"
                style="color: {{#if this.term1}}{{gradeColor this.term1}}{{else}}{{gradeColor this.grade}}{{/if}};">
                {{#if this.term1}}{{this.term1}}{{else}}{{this.grade}}{{/if}}</td>
              {{/if}}
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <!-- Right Column: Attendance Record & Teacher Remarks -->
      <div style="grid-column: span 1; display: flex; flex-direction: column;">
        <!-- Attendance Record -->
        <div class="att-card" style="margin-bottom: 5px;">
          <div class="att-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span><b>Attendance Record</b></span>
          </div>
          <div class="att-grid" style="grid-template-columns: 1fr 1fr; gap: 6px;">
            <div class="att-pill">
              <div class="att-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span><b>Total Working Days</b></span>
              </div>
              <div style="border-bottom: 1.5px dashed #94a3b8; height: 13px; margin: 0 4px;"></div>
            </div>
            <div class="att-pill">
              <div class="att-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                  <path d="m9 16 2 2 4-4"></path>
                </svg>
                <span><b>Days Present</b></span>
              </div>
              <div style="border-bottom: 1.5px dashed #94a3b8; height: 13px; margin: 0 4px;"></div>
            </div>
            {{!-- <div class="att-pill">
              <div class="att-label">Attendance %</div>
              <div
                style="border-bottom: 1.5px dashed #94a3b8; height: 13px; margin: 0 4px; text-align: right; padding-right: 2px; font-size: 11px; font-weight: 800; color: #64748b; line-height: 14px;">
                %</div>
            </div> --}}
          </div>
        </div>

        <!-- Class Teacher's Remarks -->
        <div>
          <div class="section-heading">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Class Teacher's Remarks</span>
          </div>
          <div class="remarks-box">
            "{{#if teacherRemark}}{{teacherRemark}}{{else}}Good performance. Keep it up!{{/if}}"
          </div>
        </div>
      </div>
    </div>
    {{else}}
    <!-- Layout when NO Co-Scholastic subjects exist -->
    <div class="grid grid-cols-2 gap-3" style="align-items: start; margin-bottom: 2px;">
      <!-- Left Column: Attendance Record -->
      <div style="grid-column: span 1; display: flex; flex-direction: column;">
        <div class="att-card" style="margin-bottom: 0;">
          <div class="att-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span><b>Attendance Record</b></span>
          </div>
          <div class="att-grid" style="grid-template-columns: 1fr 1fr; gap: 6px;">
            <div class="att-pill">
              <div class="att-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span><b>Total Working Days</b></span>
              </div>
              <div style="border-bottom: 1.5px dashed #94a3b8; height: 13px; margin: 0 4px;"></div>
            </div>
            <div class="att-pill">
              <div class="att-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                  <path d="m9 16 2 2 4-4"></path>
                </svg>
                <span><b>Days Present</b></span>
              </div>
              <div style="border-bottom: 1.5px dashed #94a3b8; height: 13px; margin: 0 4px;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Teacher Remarks -->
      <div style="grid-column: span 1; display: flex; flex-direction: column;">
        <div class="section-heading">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Class Teacher's Remarks</span>
        </div>
        <div class="remarks-box">
          "{{#if teacherRemark}}{{teacherRemark}}{{else}}Good performance. Keep it up!{{/if}}"
        </div>
      </div>
    </div>
    {{/if}}


    <!-- Fill remaining space to push footer to bottom if needed -->
    <div class="flex-1"></div>

    <!-- 7. SIGNATURES -->
    <div class="flex justify-between items-end mt-1 pt-1">
      {{!-- <div class="flex-col items-center">
        {{#if signatures.parent}}
        <img src="{{signatures.parent}}" class="signature-img" alt="Parent Signature">
        {{else}}
        <div style="height: 30px;"></div>
        {{/if}}
        <div class="signature-box">Parent / Guardian</div>
      </div> --}}

      <div class="flex-col items-center">
        {{#if signatures.teacher}}
        <img src="{{signatures.teacher}}" class="signature-img" alt="Teacher Signature">
        {{else}}
        <div style="height: 30px;"></div>
        {{/if}}
        <div class="signature-box">Class Teacher</div>
      </div>

      <div class="flex-col items-center">
        {{#if signatures.controller}}
        <img src="{{signatures.controller}}" class="signature-img" alt="Exam Controller Signature">
        {{else}}
        <div style="height: 30px;"></div>
        {{/if}}
        <div class="signature-box">Exam Controller</div>
      </div>

      <div class="flex-col items-center">
        {{#if signatures.principal}}
        <img src="{{signatures.principal}}" class="signature-img" alt="Principal Signature">
        {{else}}
        <div style="height: 30px;"></div>
        {{/if}}
        <div class="signature-box">Principal</div>
      </div>
    </div>


    <!-- 8. FOOTER -->
    <div
      style="margin-top: 6px; padding-top: 4px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 7.5px; color: var(--text-muted);">
      <div style="text-align: left; line-height: 1.4;">
        <div><strong>Report Card No:</strong> {{#if
          meta.report_id}}{{meta.report_id}}{{else}}TIS-RC-{{student.roll_no}}{{/if}}</div>
        <div><strong>Generated On:</strong> {{#if meta.generated_on}}{{meta.generated_on}}{{else}}{{currentDate}}{{/if}}
        </div>
      </div>

      <div style="text-align: right; line-height: 1.4;">
        <div>Generated By: {{#if meta.generated_by}}{{meta.generated_by}}{{else}}School Administration{{/if}}</div>
        <div>Software powered by {{#if meta.erp_name}}{{meta.erp_name}}{{else}}TIS ERP{{/if}} v{{#if
          meta.erp_version}}{{meta.erp_version}}{{else}}2.0{{/if}} &bull; &copy; {{#if
          meta.year}}{{meta.year}}{{else}}2026{{/if}} All Rights Reserved</div>
      </div>
    </div>


  </div>
</body>

</html>