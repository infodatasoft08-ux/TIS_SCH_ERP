<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Card - {{student.name}}</title>
  
  <!-- Embedding CSS exactly where it belongs for Handlebars Puppeteer, avoiding external file loading issues -->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500&family=Montserrat:wght@800&family=Poppins:wght@400;600&display=swap');

:root {
  --primary-blue: #1565C0;
  --dark-blue: #0D47A1;
  --gold: #FFC107;
  --border-color: #DADADA;
  --bg-color: #FFFFFF;
  --section-bg: #F8FAFC;
  --success: #16A34A;
  --danger: #DC2626;
  --text-dark: #1e293b;
  --text-muted: #64748b;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg-color);
  color: var(--text-dark);
  font-family: 'Poppins', sans-serif;
  font-size: 10px; /* Base size for A4 printing */
  line-height: 1.3;
  /* A4 Dimensions */
  width: 210mm;
  height: 297mm;
  margin: 0 auto;
  position: relative;
  -webkit-print-color-adjust: exact !important;
  print-color-adjust: exact !important;
}

/* Page Margins */
.page-container {
  padding: 5mm 8mm;
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

/* Watermark */
.watermark-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.05;
  z-index: 1;
  pointer-events: none;
  display: flex;
  justify-content: center;
  align-items: center;
}
.watermark-container img {
  width: 140mm;
  height: auto;
}

/* Typography */
.school-name {
  font-family: 'Montserrat', sans-serif;
  font-weight: 800;
  font-size: 24px;
  color: var(--dark-blue);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.school-details {
  font-size: 12.5px;
  color: var(--text-muted);
}

.section-heading {
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  font-size: 12px;
  color: var(--primary-blue);
  background: var(--section-bg);
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 6px;
  border-left: 3px solid var(--primary-blue);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.table-marks {
  font-family: 'Inter', sans-serif;
  font-weight: 500;
}

/* Utilities */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-left { text-align: left; }
.text-primary { color: var(--primary-blue); }
.text-dark { color: var(--dark-blue); }
.text-gold { color: var(--gold); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-muted { color: var(--text-muted); }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.mt-1 { margin-top: 4px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 12px; }
.mt-4 { margin-top: 16px; }
.mb-1 { margin-bottom: 4px; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mb-4 { margin-bottom: 16px; }

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }

.grid { display: grid; }
.grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
.grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
.grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
.gap-x-4 { column-gap: 16px; }
.gap-y-2 { row-gap: 8px; }

.w-full { width: 100%; }
.h-full { height: 100%; }
.flex-1 { flex: 1; }

/* Cards & Sections */
.card {
  background: var(--bg-color);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 6px;
}

.card-highlight {
  background: linear-gradient(135deg, var(--dark-blue), var(--primary-blue));
  color: white;
  border: none;
}
.card-highlight .section-heading {
  color: white;
  background: rgba(255, 255, 255, 0.1);
  border-left-color: var(--gold);
}
.card-highlight .text-muted {
  color: rgba(255,255,255,0.8);
}
.card-highlight .text-dark {
  color: white;
}

/* Tables */
table {
  width: 100%;
  border-collapse: collapse;
  
  border: 1px solid var(--border-color);
  border-radius: 6px;
  overflow: hidden;
}

th, td {
  padding: 3px 4px;
  border: 1px solid var(--border-color);
  font-size: 11px;
  text-align: center;
}

th {
  background: var(--section-bg);
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  color: var(--dark-blue);
  text-align: center;
  vertical-align: middle;
}


thead tr:nth-child(2) th:last-child {
  border-right: 1px solid var(--border-color);
}


tbody tr:nth-child(even) {
  background-color: #FAFAFA;
}

.table-header-group {
  background: var(--bg-color);
  border-bottom: 2px solid var(--dark-blue);
}
.table-header-group th {
  border-bottom: 1px solid var(--border-color);
}

.row-total td {
  background-color: #f1f5f9;
  font-weight: 600;
  color: var(--dark-blue);
}

/* Specific elements */
.student-photo {
  width: 25mm;
  height: 32mm;
  object-fit: cover;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 2px;
  background: white;
}

.info-label {
  font-size: 10.5px;
  color: var(--text-muted);
  text-transform: uppercase;
  margin-bottom: 2px;
}
.info-value {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-dark);
}

.progress-bar-bg {
  background: var(--border-color);
  border-radius: 10px;
  height: 6px;
  width: 100%;
  overflow: hidden;
  margin-top: 4px;
}
.progress-bar-fill {
  background: var(--success);
  height: 100%;
  border-radius: 10px;
}

.badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 10px;
  font-size: 8px;
  font-weight: 600;
  text-transform: uppercase;
}
.badge-success { background: #dcfce7; color: var(--success); }
.badge-danger { background: #fee2e2; color: var(--danger); }
.badge-primary { background: #e0f2fe; color: var(--primary-blue); }

.remarks-box {
  min-height: 40px;
  font-style: italic;
  font-size: 9.5px;
  color: var(--text-dark);
  border: 1px dashed var(--border-color);
  padding: 6px;
  border-radius: 4px;
  background: var(--section-bg);
}

/* Signatures */
.signature-box {
  border-top: 1px solid var(--border-color);
  width: 35mm;
  text-align: center;
  padding-top: 2px;
  margin-top: 5px; /* space for signature */
  font-size: 8.5px;
  font-weight: 600;
  color: var(--text-dark);
}
.signature-img {
  height: 25px;
  margin-bottom: 5px;
  object-fit: contain;
}

.qr-code {
  width: 16mm;
  height: 16mm;
}

.footer-text {
  font-size: 7.5px;
  color: var(--text-muted);
}

/* Printing logic */
@media print {
  @page {
    size: A4 portrait;
    margin: 0;
  }
  body {
    width: 210mm;
    height: 297mm;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    margin: 0;
  }
  .page-container {
    page-break-after: avoid;
    page-break-inside: avoid;
  }
  table, tr, td, th {
    page-break-inside: avoid;
  }
}

  </style>
</head>
<body>
  
  {{#if showWatermark}}
  <div class="watermark-container">
    {{#if school.logo}}
      <img src="{{school.logo}}" alt="Watermark">
    {{/if}}
  </div>
  {{/if}}

  <div class="page-container">
    
    <!-- 1. HEADER -->
    <div class="flex justify-between items-start mb-2 pb-1 border-b-2 border-gray-200">
  <!-- School Logo -->
  <div style="width: 20%;">
    {{#if logoData}}
      <img src="{{logoData}}" alt="School Logo" style="width: 25mm; height: 25mm; object-fit: contain;">
    {{else if school.logo}}
      <img src="{{school.logo}}" alt="School Logo" style="width: 25mm; height: 25mm; object-fit: contain;">
    {{/if}}
  </div>

  <!-- School Details (Centered) -->
  <div style="width: 60%; text-align: center;">
    <h1 class="school-name font-bold" style="color: var(--dark-blue); font-size: 22px; margin-bottom: 2px;">{{school.name}}</h1>
    <div class="school-details mt-1 font-semibold" style="color: #4b5563; font-size: 12.5px; line-height: 1.4;">
      <p>Address : {{school.address}}</p>
      <p>Cont.: {{school.phone}}</p>
      <p>Email : {{school.email}} | Website : {{school.website}}</p>
    </div>
    {{#if school.tagline}}
      <div class="mt-2 flex items-center justify-center gap-1 w-full" style="max-width: 480px; margin-left: auto; margin-right: auto;">
        <div class="flex-1" style="height: 1.5px; background: linear-gradient(to right, transparent, #eab308);"></div>
        <div style="width: 7px; height: 7px; background: #eab308; transform: rotate(45deg); flex-shrink: 0; margin-right: 2px;"></div>
        
        <div style="background: linear-gradient(180deg, #0d2873 0%, #061543 100%); color: #ffffff; font-weight: 700; font-size: 10.5px; padding: 3px 22px; clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 100%, 0 100%); letter-spacing: 0.4px;">
          {{school.tagline}}
        </div>

        <div style="width: 7px; height: 7px; background: #eab308; transform: rotate(45deg); flex-shrink: 0; margin-left: 2px;"></div>
        <div class="flex-1" style="height: 1.5px; background: linear-gradient(to left, transparent, #eab308);"></div>
      </div>
    {{/if}}
  </div>

  <!-- Right Side Badges -->
  <div style="width: 20%;" class="flex flex-col items-end text-right">
    <div class="font-bold uppercase" style="color: var(--dark-blue); font-size: 13.5px; letter-spacing: 0.5px;">
      {{reportTitle}}
    </div>
    <div class="badge badge-primary mt-2" style="font-size: 11.5px;">
      Session: {{student.academic_year_name}}
    </div>
  </div>
</div>


    <!-- 2. STUDENT PROFILE -->
    <div class="card mb-2">
  <div class="flex justify-between gap-4">
    <!-- Left Side: Student Info Grid -->
    <div class="flex-1 grid grid-cols-3 gap-x-4 gap-y-2">
      <div>
        <div class="info-label">Admission No</div>
        <div class="info-value">{{student.admission_no}}</div>
      </div>
      <div>
        <div class="info-label">Roll No</div>
        <div class="info-value">{{student.roll_no}}</div>
      </div>
      <div>
        <div class="info-label">Class & Section</div>
        <div class="info-value">{{#if student.class_section}}{{student.class_section}}{{else}}{{student.class}}{{#if student.section}} - {{student.section}}{{/if}}{{/if}}</div>
      </div>
      
      <div>
        <div class="info-label">Student Name</div>
        <div class="info-value">{{student.name}}</div>
      </div>
      <div>
        <div class="info-label">Date of Birth</div>
        <div class="info-value">{{student.dob}}</div>
      </div>
      <div>
        <div class="info-label">Gender / Blood Group</div>
        <div class="info-value">{{student.gender}} / {{student.blood_group}}</div>
      </div>

      <div>
        <div class="info-label">Father's Name</div>
        <div class="info-value">{{#if student.father_name}}{{student.father_name}}{{else}}{{student.fathers_name}}{{/if}}</div>
      </div>
      <div>
        <div class="info-label">Mother's Name</div>
        <div class="info-value">{{#if student.mother_name}}{{student.mother_name}}{{else}}{{student.mothers_name}}{{/if}}</div>
      </div>
      <div class="grid-col-span-2" style="grid-column: span 3;">
        <div class="info-label">Address</div>
        <div class="info-value">{{student.address}}</div>
      </div>
    </div>

    <!-- Right Side: Photo and Status -->
    <div class="flex-col items-center justify-center border-l" style="padding-left: 16px; border-left: 1px solid var(--border-color);">
      {{#if student.photo}}
        <img src="{{student.photo}}" alt="Student Photo" class="student-photo mb-2">
      {{else}}
        <div class="student-photo mb-2 bg-gray-100 flex items-center justify-center text-muted">No Photo</div>
      {{/if}}
      <div class="badge {{#if (eq student.status 'Active')}}badge-success{{else}}badge-danger{{/if}}">
        {{student.status}}
      </div>
    </div>
  </div>
</div>


    <!-- 3. MARKS TABLE -->
    <div class="mb-2">
  <div class="section-heading">Part 1: Scholastic Areas</div>
  <table class="table-marks data-table" style="margin-bottom: 0;">
    <thead>
      <tr class="table-header-group">
        <th rowspan="2" style="text-align: left;">Subjects</th>
        <th rowspan="2">Max Marks</th>
        {{#if showFinalResult}}
            <th colspan="{{exam1ColSpan}}">{{exam1Name}}</th>
            <th colspan="{{exam2ColSpan}}">{{exam2Name}}</th>
            <th rowspan="2">Final Total</th>
        {{else}}
            <th colspan="{{examColSpan}}">Marks / Grade</th>
        {{/if}}
        <th rowspan="2">Grade</th>
      </tr>
      <tr>
        <!-- Term 1 columns -->
        {{#each dynamicColumns}}<th>{{this.name}} <br><small>({{this.max}})</small></th>{{/each}}
        <th>Total</th>
        
        <!-- Term 2 columns -->
        {{#if showFinalResult}}
            {{#each dynamicColumns}}<th>{{this.name}} <br><small>({{this.max}})</small></th>{{/each}}
            <th>Total</th>
        {{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each subjects}}
      <tr>
        <td style="text-align: left; font-weight: 600; color: var(--dark-blue);">{{this.subject_name}}</td>
        <td>{{this.max}}</td>
        <!-- Term 1 marks -->
        {{#each this.exam1_dynamicMarks}}<td>{{this.value}}</td>{{/each}}
        <td class="font-semibold">{{this.exam1_marks}}</td>
        
        <!-- Term 2 marks -->
        {{#if ../showFinalResult}}
            {{#each this.exam2_dynamicMarks}}<td>{{this.value}}</td>{{/each}}
            <td class="font-semibold">{{this.exam2_marks}}</td>
            
            <!-- Final Total -->
            <td class="font-bold text-primary">{{this.total}}</td>
        {{/if}}
        <td class="font-bold" style="color: {{gradeColor this.grade}};">{{this.grade}}</td>
      </tr>
      {{/each}}
      
      <!-- Totals Row -->
      <tr class="row-total">
        <td style="text-align: left;">Grand Total</td>
        <td>{{totalMax}}</td>
        {{#if showFinalResult}}
            <td colspan="{{exam1ColSpan}}" class="text-right" style="padding-right: 15px;">-</td>
            <td colspan="{{exam2ColSpan}}" class="text-right" style="padding-right: 15px;">-</td>
            <td class="text-primary font-bold">{{totalObtained}} / {{totalMax}}</td>
        {{else}}
            {{#if baseNewFields}}
                <td colspan="{{baseNewFields}}"></td>
            {{/if}}
            <td class="text-primary font-bold">{{totalObtained}}</td>
            <td class="font-bold" style="color: {{gradeColor grandGrade}};">{{#if grandGrade}}{{grandGrade}}{{else}}-{{/if}}</td>
        {{/if}}
      </tr>
    </tbody>
  </table>
</div>


    <!-- 4. CO-SCHOLASTIC GRADING & ATTENDANCE -->
    <div class="grid grid-cols-2 gap-4">
      <div style="grid-column: span 1;">
        <div class="mb-2">
  <div class="section-heading">Part 2: Co-Scholastic & Skill-Based Areas</div>
  <table class="table-marks data-table" style="margin-bottom: 0;">
    <thead>
      <tr>
        <th style="text-align: left;">Activity / Area</th>
        {{#if attendanceStats.hasTerm1}}
        <th>Term I</th>
        {{/if}}
        {{#if attendanceStats.hasTerm2}}
        <th>Term II</th>
        {{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each coScholastic}}
      <tr>
        <td style="text-align: left; font-weight: 500;">{{this.name}}</td>
        {{#if ../attendanceStats.hasTerm1}}
        <td class="font-bold text-center">{{this.term1}}</td>
        {{/if}}
        {{#if ../attendanceStats.hasTerm2}}
        <td class="font-bold text-center">{{this.term2}}</td>
        {{/if}}
      </tr>
      {{/each}}
      {{#each skillBased}}
      <tr>
        <td style="text-align: left; font-weight: 500;">{{this.name}}</td>
        {{#if ../attendanceStats.hasTerm1}}
        <td class="font-bold text-center">{{this.term1}}</td>
        {{/if}}
        {{#if ../attendanceStats.hasTerm2}}
        <td class="font-bold text-center">{{this.term2}}</td>
        {{/if}}
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

      </div>
      <div style="grid-column: span 1;" class="flex-col gap-3">
        <div class="mb-2">
  <style>
    .att-card {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 8px 12px;
      background: #ffffff;
      margin-bottom: 6px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    }
    .att-title {
      color: #1d4ed8;
      font-weight: 700;
      font-size: 10.5px;
      text-transform: uppercase;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }
    .att-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
      column-gap: 16px;
      align-items: start;
    }
    .att-label {
      color: #64748b;
      font-size: 8px;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.3px;
      line-height: 1.2;
    }
    .att-val {
      color: #1e293b;
      font-size: 12.5px;
      font-weight: 600;
      margin-top: 3px;
    }
    .att-percent-col {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: flex-start;
      padding-left: 8px;
    }
    .att-percent-label {
      color: #64748b;
      font-size: 8px;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.3px;
      line-height: 1.2;
    }
    .att-percent-val {
      color: #0f172a;
      font-size: 16px;
      font-weight: 800;
      line-height: 1.2;
      margin-top: 2px;
    }
    .att-bar-wrap {
      grid-column: span 2;
      margin-top: 6px;
    }
    .att-bar-bg {
      background: #e2e8f0;
      border-radius: 9999px;
      height: 6px;
      width: 100%;
      overflow: hidden;
    }
    .att-bar-fill {
      background: #1d4ed8;
      height: 100%;
      border-radius: 9999px;
    }
  </style>

  {{#if attendanceStats.hasTerm1}}
    {{#if attendanceStats.hasTerm2}}
    <div class="att-card">
      <div class="att-title" style="font-size: 9.5px;">{{exam1Name}} Attendance Record</div>
      <div class="att-grid">
        <div>
          <div class="att-label">Total Working Days:</div>
          <div class="att-val">{{attendanceStats.term1Working}}</div>
        </div>
        <div>
          <div class="att-label">Days Present:</div>
          <div class="att-val">{{attendanceStats.term1Attended}}</div>
        </div>
        <div class="att-percent-col">
          <div class="att-percent-label">Attendance %</div>
          <div class="att-percent-val">{{attendanceStats.term1Percentage}}%</div>
        </div>
        <div class="att-bar-wrap">
          <div class="att-bar-bg">
            <div class="att-bar-fill" style="width: {{attendanceStats.term1Percentage}}%;"></div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
  {{/if}}

  {{#if attendanceStats.hasTerm2}}
    <div class="att-card">
      <div class="att-title" style="font-size: 9.5px;">{{exam2Name}} Attendance Record</div>
      <div class="att-grid">
        <div>
          <div class="att-label">Total Working Days:</div>
          <div class="att-val">{{attendanceStats.term2Working}}</div>
        </div>
        <div>
          <div class="att-label">Days Present:</div>
          <div class="att-val">{{attendanceStats.term2Attended}}</div>
        </div>
        <div class="att-percent-col">
          <div class="att-percent-label">Attendance %</div>
          <div class="att-percent-val">{{attendanceStats.term2Percentage}}%</div>
        </div>
        <div class="att-bar-wrap">
          <div class="att-bar-bg">
            <div class="att-bar-fill" style="width: {{attendanceStats.term2Percentage}}%;"></div>
          </div>
        </div>
      </div>
    </div>
  {{/if}}


</div>

        
        <!-- 5. RESULT SUMMARY -->
        <div class="card card-highlight mb-2">
  <div class="section-heading mb-2">Result Summary</div>
  
  <div class="grid grid-cols-3 gap-4 text-center">
    <div class="border-r border-white/20">
      <div class="text-muted info-label" style="color: rgba(255,255,255,0.7);">Percentage</div>
      <div class="font-bold text-white" style="font-size: 16px;">{{percentage}}%</div>
    </div>
    
    <div class="border-r border-white/20">
      <div class="text-muted info-label" style="color: rgba(255,255,255,0.7);">Final Result</div>
      <div class="font-bold {{#if (eq finalResult 'Pass')}}text-success{{else}}text-danger{{/if}}" style="font-size: 16px; background: rgba(255,255,255,0.9); display: inline-block; padding: 2px 8px; border-radius: 4px; margin-top: -2px;">
        {{finalResult}}
      </div>
    </div>
    
    <div>
      <div class="text-muted info-label" style="color: rgba(255,255,255,0.7);">Promotion Status</div>
      <div class="font-bold text-white" style="font-size: 16px;">
        {{#if promotionStatus}}{{promotionStatus}}{{else}}{{finalResult}}{{/if}}
      </div>
    </div>
  </div>
  
  {{#if promotionStatus}}
  <div class="mt-2 pt-2 border-t border-white/20 text-center text-white font-semibold">
    Promoted to Class: <span class="text-gold">{{nextGrade}}</span>
  </div>
  {{/if}}
</div>

      </div>
    </div>

    <!-- 6. REMARKS -->
    <div class="grid grid-cols-2 gap-4 mb-2">
  <div>
    <div class="info-label mb-1">Class Teacher's Remarks</div>
    <div class="remarks-box">
      {{teacherRemark}}
    </div>
  </div>
  <div>
    <div class="info-label mb-1">Principal's Remarks</div>
    <div class="remarks-box">
      {{principalRemark}}
    </div>
  </div>
</div>


    <!-- Fill remaining space to push footer to bottom if needed -->
    <div class="flex-1"></div>

    <!-- 7. SIGNATURES -->
    <div class="flex justify-between items-end mt-1 pt-1">
  <div class="flex-col items-center">
    {{#if signatures.parent}}
      <img src="{{signatures.parent}}" class="signature-img" alt="Parent Signature">
    {{else}}
      <div style="height: 30px;"></div>
    {{/if}}
    <div class="signature-box">Parent / Guardian</div>
  </div>

  <div class="flex-col items-center">
    {{#if signatures.teacher}}
      <img src="{{signatures.teacher}}" class="signature-img" alt="Teacher Signature">
    {{else}}
      <div style="height: 30px;"></div>
    {{/if}}
    <div class="signature-box">Class Teacher</div>
  </div>

  <div class="flex-col items-center">
    {{#if signatures.controller}}
      <img src="{{signatures.controller}}" class="signature-img" alt="Exam Controller Signature">
    {{else}}
      <div style="height: 30px;"></div>
    {{/if}}
    <div class="signature-box">Exam Controller</div>
  </div>

  <div class="flex-col items-center">
    {{#if signatures.principal}}
      <img src="{{signatures.principal}}" class="signature-img" alt="Principal Signature">
    {{else}}
      <div style="height: 30px;"></div>
    {{/if}}
    <div class="signature-box">Principal</div>
  </div>
</div>


    <!-- 8. FOOTER -->
    <div class="mt-2 pt-2 border-t border-border-color flex justify-between items-center footer-text">
  <div class="flex gap-3 items-center">
    {{#if qr_code}}
      <img src="{{qr_code}}" alt="QR Code" class="qr-code">
    {{/if}}
    <div class="flex-col">
      <span class="font-semibold text-dark">Scan QR to Verify</span>
      <span>Report Card No: {{meta.report_id}}</span>
      <span>Generated On: {{meta.generated_on}}</span>
    </div>
  </div>
  
  <div class="text-right">
    <div>Generated By: {{meta.generated_by}}</div>
    <div>Software powered by {{meta.erp_name}} v{{meta.erp_version}}</div>
    <div>&copy; {{meta.year}} All Rights Reserved</div>
  </div>
</div>


  </div>
</body>
</html>
